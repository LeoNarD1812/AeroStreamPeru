    {
      "id": 7,
      "title": "Leonardo · Volumen promedio · Seguimiento en vivo",
      "type": "timeseries",
      "description": "Aeronaves en vuelo en la última captura de OpenSky, cada dos minutos, y dos pronósticos del promedio de la próxima ventana de diez minutos. El eje marca cuándo Prometheus vio la actualización.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "aerostream_bi_captura_aeronaves_en_vuelo{job=\"aerostream_bi_captura\"}",
          "legendFormat": "OpenSky · última captura",
          "refId": "A",
          "instant": false,
          "range": true
