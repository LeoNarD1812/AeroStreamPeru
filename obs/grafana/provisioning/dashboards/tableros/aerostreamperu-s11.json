{
  "uid": "aerostreamperu-s11",
  "title": "AeroStreamPeru · Tráfico aéreo y pronósticos",
  "tags": [
    "AeroStreamPeru",
    "S11"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-2h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Capturas procesadas · batch",
      "type": "stat",
      "description": "Instantes únicos en la evidencia Parquet de S9 al ejecutar el cálculo batch.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "aerostream_bi_batch_capturas{job=\"aerostream_bi_batch\"}",
          "legendFormat": "Capturas",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Capturas válidas · batch",
      "type": "stat",
      "description": "Proporción de capturas correctas sobre los instantes procesados de S9.",
