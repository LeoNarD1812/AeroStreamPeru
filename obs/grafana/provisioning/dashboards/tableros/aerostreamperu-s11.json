        {
          "expr": "aerostream_bi_pronostico_persistencia{job=\"aerostream_bi_leonardo\"}",
          "legendFormat": "Persistencia · próxima ventana",
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
